# Postgres connection string (from Vercel's Neon Postgres integration,
# or any Postgres host). Vercel injects this automatically once connected.
DATABASE_URL=

# Random long secret used to sign admin login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Only needed locally when running scripts/seed-admin.ts:
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password
